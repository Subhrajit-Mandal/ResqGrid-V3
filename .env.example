# Local demo API. Frontend currently uses its separate browser-local simulation.
RESQGRID_MODE=demo
RESQGRID_ALLOWED_ORIGINS=http://localhost:4173,http://terminal.local:4173
# Required for production: use distinct restricted API and worker database logins.
RESQGRID_POSTGRES_URL=
RESQGRID_MONGODB_URI=
RESQGRID_MONGODB_DATABASE=resqgrid_v3
RESQGRID_SUPABASE_URL=
RESQGRID_MQTT_HOST=
RESQGRID_MQTT_PORT=8883
RESQGRID_MQTT_USERNAME=
RESQGRID_MQTT_PASSWORD=
RESQGRID_MODEL_MANIFEST=
RESQGRID_MAXIMUM_STALENESS_SECONDS=120
# These are public configuration, never Supabase service keys or database passwords.
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
