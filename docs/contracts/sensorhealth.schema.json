{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "message_id": {
      "title": "Message Id",
      "type": "string"
    },
    "device_id": {
      "title": "Device Id",
      "type": "string"
    },
    "node_id": {
      "title": "Node Id",
      "type": "string"
    },
    "zone_id": {
      "title": "Zone Id",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "firmware_version": {
      "title": "Firmware Version",
      "type": "string"
    },
    "uptime_seconds": {
      "minimum": 0,
      "title": "Uptime Seconds",
      "type": "integer"
    },
    "connectivity": {
      "enum": [
        "online",
        "degraded",
        "offline"
      ],
      "title": "Connectivity",
      "type": "string"
    },
    "calibration": {
      "enum": [
        "valid",
        "due",
        "unknown"
      ],
      "title": "Calibration",
      "type": "string"
    },
    "battery_percent": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Battery Percent"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "source_mode": {
      "enum": [
        "hardware",
        "simulated",
        "replay"
      ],
      "title": "Source Mode",
      "type": "string"
    }
  },
  "required": [
    "message_id",
    "device_id",
    "node_id",
    "zone_id",
    "observed_at",
    "firmware_version",
    "uptime_seconds",
    "connectivity",
    "calibration",
    "source_mode"
  ],
  "title": "SensorHealth",
  "type": "object"
}
