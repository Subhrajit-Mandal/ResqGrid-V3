{
  "$defs": {
    "Location": {
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "source": {
          "enum": [
            "gps",
            "manual",
            "provisioned",
            "simulated"
          ],
          "title": "Source",
          "type": "string"
        },
        "accuracy_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accuracy M"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        }
      },
      "required": [
        "latitude",
        "longitude",
        "source",
        "captured_at"
      ],
      "title": "Location",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "zone_id": {
      "title": "Zone Id",
      "type": "string"
    },
    "location": {
      "$ref": "#/$defs/Location"
    },
    "status": {
      "enum": [
        "open",
        "closed",
        "unknown"
      ],
      "title": "Status",
      "type": "string"
    },
    "capacity": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capacity"
    },
    "occupancy": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Occupancy"
    },
    "verified_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verified At"
    },
    "source_mode": {
      "enum": [
        "verified",
        "simulated"
      ],
      "title": "Source Mode",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "zone_id",
    "location",
    "status",
    "source_mode"
  ],
  "title": "Shelter",
  "type": "object"
}
