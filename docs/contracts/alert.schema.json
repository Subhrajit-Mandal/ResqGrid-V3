      "enum": [
        "Draft",
        "Published",
        "Retracted"
      ],
      "title": "Status",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    }
