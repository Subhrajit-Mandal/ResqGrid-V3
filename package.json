{
  "name": "resqgrid-v3",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts --host 0.0.0.0 --port 4173",
    "build": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "test": "vitest run",
    "format": "prettier --write frontend tests/frontend tests/e2e *.ts package.json",
    "format:check": "prettier --check frontend tests/frontend tests/e2e *.ts package.json",
    "lint": "tsc -p frontend/tsconfig.json --noEmit && npm run format:check"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
